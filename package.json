{
  "name": "triage-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint packages evals",
    "format": "prettier --write .",
    "demo": "pnpm --filter @triage/agent demo",
    "run:live": "pnpm --filter @triage/agent run:live",
    "dashboard": "pnpm --filter @triage/dashboard dev",
    "eval": "pnpm --filter @triage/evals full",
    "eval:smoke": "pnpm --filter @triage/evals smoke",
    "demo:ingest": "pnpm --filter @triage/ingestor demo",
    "demo:mcp": "pnpm --filter @triage/mcp-server demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
